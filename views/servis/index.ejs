
<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h5>Riwayat Servis Kendaraan</h5>
        <p class="text-muted mb-0">Kelola seluruh transaksi servis bengkel.</p>
    </div>

    <a href="/servis/tambah" class="btn btn-orange">
        <i class="bi bi-plus-lg"></i> Tambah Servis
    </a>
</div>

<div class="content-card">
    <form action="/servis" method="GET" class="row g-2 mb-4">
        <div class="col-md-6">
            <input
                type="text"
                name="search"
                class="form-control"
                placeholder="Cari nama atau nomor polisi..."
                value="<%= search %>"
            >
        </div>

        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">Semua Status</option>
                <option value="Menunggu" <%= status === 'Menunggu' ? 'selected' : '' %>>Menunggu</option>
                <option value="Sedang Dikerjakan" <%= status === 'Sedang Dikerjakan' ? 'selected' : '' %>>Sedang Dikerjakan</option>
                <option value="Selesai" <%= status === 'Selesai' ? 'selected' : '' %>>Selesai</option>
            </select>
        </div>

        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-orange flex-fill">
                <i class="bi bi-search"></i> Cari
            </button>

            <a href="/servis" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Pelanggan</th>
                    <th>Kendaraan</th>
                    <th>Tanggal</th>
                    <th>Keluhan</th>
                    <th>Status</th>
                    <th>Biaya</th>
                    <th>Aksi</th>
                </tr>
            </thead>

            <tbody>
                <% if (servis.length === 0) { %>
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            Data servis tidak ditemukan.
                        </td>
                    </tr>
                <% } else { %>
                    <% servis.forEach(item => { %>
                        <tr>
                            <td>#<%= item.id_servis %></td>
                            <td><%= item.nama_pelanggan %></td>
                            <td>
                                <strong><%= item.nomor_polisi %></strong><br>
                                <small class="text-muted">
                                    <%= item.merek %> <%= item.tipe %>
                                </small>
                            </td>
                            <td>
                                <%= new Date(item.tanggal_servis).toLocaleDateString('id-ID') %>
                            </td>
                            <td><%= item.keluhan || '-' %></td>
                            <td>
                                <span class="status-badge <%= 
                                    item.status === 'Menunggu' ? 'waiting' :
                                    item.status === 'Sedang Dikerjakan' ? 'processing' :
                                    'completed'
                                %>">
                                    <%= item.status %>
                                </span>
                            </td>
                            <td>
                                Rp <%= new Intl.NumberFormat('id-ID').format(Number(item.total_biaya)) %>
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a
                                        href="/servis/edit/<%= item.id_servis %>"
                                        class="btn btn-sm btn-outline-primary"
                                        title="Edit"
                                    >
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <form
                                        action="/servis/hapus/<%= item.id_servis %>"
                                        method="POST"
                                        onsubmit="return confirm('Yakin ingin menghapus transaksi servis ini?')"
                                    >
                                        <button
                                            type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            title="Hapus"
                                        >
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/footer') %>
